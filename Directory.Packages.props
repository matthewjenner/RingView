<Project>
  <!--
    Central package versions. Every PackageReference in Src/ and Tests/ omits Version and picks it
    up from here. Versions were checked against nuget.org when added (latest stable); check again
    before bumping. Spikes/ opts out (Spikes/Directory.Packages.props).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI. Avalonia: MIT. CommunityToolkit.Mvvm: MIT. -->
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Ring. SIPSorcery: BSD-3 plus a geographic use restriction (Docs/workplan.md decisions). -->
    <PackageVersion Include="SIPSorcery" Version="10.0.17" />

    <!--
      Media (Windows). Vortice: MIT. NAudio: MIT - use the 3.x family; NAudio.Wasapi 22.0.0 on
      nuget.org is a mis-numbered old build that depends on NAudio.Core 2.2. Concentus: Opus
      decoding, BSD-3.
    -->
    <PackageVersion Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageVersion Include="Concentus" Version="2.2.2" />

    <!--
      Platform (Windows): DPAPI for the stored token and the Electron import (MIT); Velopack, the
      installer and updater (MIT).
    -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageVersion Include="Velopack" Version="1.2.161" />

    <!-- Tests. AwesomeAssertions is the Apache-2.0 fork of FluentAssertions 7 (8 is commercial). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!--
      Headless UI tests: the real views driven by simulated mouse and keyboard. Avalonia.Headless,
      not Avalonia.Headless.XUnit: the latter is built against xunit.v3 3.x and fails test discovery
      on xunit.v3 4 (MissingMethodException); UiHarness runs the session directly instead.
    -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
  </ItemGroup>
</Project>
