<Project>
  <!--
    Single source of truth for the app version. Inherited by every csproj in the repo.
    Bump with scripts/dotnet-bump-version.sh; release-dotnet.yml releases v$(VersionPrefix)
    to this repo's GitHub releases when no release for it exists yet.
  -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <!--
      Stops the .NET SDK appending "+<git-commit-hash>" to AssemblyInformationalVersion, so the
      About box and the update check see a clean "1.2.3".
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Matt Jenner</Authors>
    <Product>RingView</Product>
  </PropertyGroup>

  <!-- Shared values for the Windows-specific projects; Core and Core.Tests ignore them. -->
  <PropertyGroup>
    <!-- 19041 = Windows 10 2004, the oldest supported build with the Media Foundation and D3D11 video APIs used. -->
    <RingViewWindowsTfm>net10.0-windows10.0.19041.0</RingViewWindowsTfm>
    <RingViewMinWindows>10.0.19041.0</RingViewMinWindows>
  </PropertyGroup>
</Project>
