<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway spike (workplan phase M2): proves the C# Ring path end to end before the real
    projects exist. Deleted once RingView.Ring replaces it. Not part of any release.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The smoke command runs the production Core + Ring code against the real service. -->
    <ProjectReference Include="..\..\Src\RingView.Ring\RingView.Ring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions checked on nuget.org 2026-11-05 (latest stable). -->
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
