<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway spike (workplan phase M2, second half): live Ring video decoded with Windows Media
    Foundation into Avalonia tiles with overlays, Opus audio via Concentus + WASAPI, CPU measured.
    Shares the Ring session code with RingView.Spike by linking its files.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../RingView.Spike/ElectronTokenStore.cs" Link="Ring/ElectronTokenStore.cs" />
    <Compile Include="../RingView.Spike/RingToken.cs" Link="Ring/RingToken.cs" />
    <Compile Include="../RingView.Spike/RingRest.cs" Link="Ring/RingRest.cs" />
    <Compile Include="../RingView.Spike/LiveSpike.cs" Link="Ring/LiveSpike.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions checked on nuget.org 2026-11-05 (latest stable). -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

</Project>
