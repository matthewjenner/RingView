#!/usr/bin/env sh
# RingView pre-commit hook. Two independent steps, each labelled so a failure is
# unambiguous about which one stopped the commit:
#   1/2  lint-staged: ESLint --fix + Prettier --write on staged files
#   2/2  gitleaks:    secret scan of staged changes

echo "[pre-commit 1/2] lint-staged (eslint --fix + prettier) on staged files…"
if ! npx --no-install lint-staged; then
  echo ""
  echo "✗ pre-commit stopped at STEP 1 (lint-staged): fix the ESLint error(s) above."
  exit 1
fi

echo "[pre-commit 2/2] gitleaks secret scan…"
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --config .gitleaks.toml; then
    echo ""
    echo "✗ pre-commit stopped at STEP 2 (gitleaks): a potential secret was found in"
    echo "  staged changes (see the finding above). If it's a false positive — e.g. a"
    echo "  test fixture — add an allowlist entry to .gitleaks.toml."
    exit 1
  fi
else
  echo "  gitleaks not installed — skipping local scan (CI enforces it as a hard gate)."
  echo "  Install to catch leaks pre-commit: https://github.com/gitleaks/gitleaks#installing"
fi

echo "✓ pre-commit checks passed."
