#!/usr/bin/env sh
# RingView pre-commit hook: lint/format staged files, then secret-scan with gitleaks.

# ESLint --fix + Prettier --write on staged files (see "lint-staged" in package.json).
# Blocks the commit if ESLint reports an unfixable error.
echo "lint-staged: formatting and linting staged files..."
npx --no-install lint-staged || exit 1

# Secret scan. If gitleaks isn't installed locally we WARN but don't block — CI runs
# the same scan as a hard gate (see .github/workflows/ci.yml), so nothing slips through.
# Install locally to catch leaks before they're committed:
#   winget install gitleaks      (Windows)
#   brew install gitleaks        (macOS)
if command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks: scanning staged changes..."
  gitleaks protect --staged --redact --config .gitleaks.toml || {
    echo ""
    echo "gitleaks blocked this commit: a potential secret was found in staged changes."
    echo "Review the finding above. If it's a false positive, add an allowlist entry to .gitleaks.toml."
    exit 1
  }
else
  echo "gitleaks not installed locally — skipping local scan (CI will still enforce it)."
  echo "Install it to catch secrets pre-commit: https://github.com/gitleaks/gitleaks#installing"
fi
